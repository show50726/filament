material {
    name : "mboitResolve",
    shadingModel : unlit,
    domain : postprocess,
    blending : transparent,
    vertexDomain : device,
    depthWrite : false,
    depthCulling : false,
    parameters : [
        { type : sampler2d, name : moments },
        { type : sampler2d, name : color },
        { type : sampler2d, name : depth },
        { type : float, name : momentBias, default : 0.000001 },
        { type : float, name : overestimation, default : 0.1 }
    ],
    variables : [
        vertex
    ],
    colorWrite : true
}

vertex {
    void postProcessVertex(inout PostProcessVertexInputs postProcess) {
        postProcess.vertex.xy = uvToRenderTargetUV(postProcess.normalizedUV);
    }
}

fragment {
    void resolveMoments(out float transmittance_at_depth, out float total_transmittance, float depth, vec2 uv) {
        transmittance_at_depth = 1.0;
        total_transmittance = 1.0;

        // b0 is stored in color.a
        float b_0 = texture(materialParams_color, uv).a;

        if (b_0 < 0.00100050033) {
            return;
        }

        total_transmittance = exp(-b_0);

        // b1, b2, b3, b4 are stored in moments
        vec4 b_1234 = texture(materialParams_moments, uv);

        vec4 normalized_moments = b_1234 / b_0;

        // Even: y=b2, w=b4
        // Odd:  x=b1, z=b3
        vec2 b_even = normalized_moments.yw;
        vec2 b_odd  = normalized_moments.xz;

        const vec4 bias_vector = vec4(0.0, 0.375, 0.0, 0.375);

        transmittance_at_depth = computeTransmittanceAtDepthFrom4PowerMoments(
            b_0,
            b_even,
            b_odd,
            depth,
            materialParams.momentBias,
            materialParams.overestimation,
            bias_vector
        );
    }

    void postProcess(inout PostProcessInputs postProcess) {
        highp vec2 uv = variable_vertex.xy;
        vec4 accumColor = texture(materialParams_color, uv);

        float transmittance_at_depth = 1.0;
        float total_transmittance = 1.0;

        float depth = texture(materialParams_depth, uv).r;
        resolveMoments(transmittance_at_depth, total_transmittance, depth, uv);

        float b0 = accumColor.a;
        if (b0 < 0.001) {
            postProcess.color = vec4(0.0);
            return;
        }

        vec3 avgColor = accumColor.rgb / b0;
        postProcess.color = vec4(avgColor * (1.0 - total_transmittance), 1.0 - total_transmittance);
    }
}
