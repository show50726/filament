material {
    name : "oitResolve",
    shadingModel : unlit,
    domain : postprocess,
    blending : transparent,
    vertexDomain : device,
    depthWrite : false,
    depthCulling : false,
    parameters : [
        { type : sampler2d, name : accumulation },
        { type : sampler2d, name : revealage }
    ],
    variables : [
        vertex
    ],
    colorWrite : true
}

vertex {
    void postProcessVertex(inout PostProcessVertexInputs postProcess) {
        postProcess.vertex.xy = uvToRenderTargetUV(postProcess.normalizedUV);
    }
}

fragment {
    void postProcess(inout PostProcessInputs postProcess) {
        highp vec2 uv = variable_vertex.xy;
        vec4 accum = texture(materialParams_accumulation, uv);
        float reveal = exp(texture(materialParams_revealage, uv).r);
        vec3 color = accum.rgb / max(accum.a, 1e-5);

        postProcess.color = vec4(color, 1.0 - reveal);
    }
}
